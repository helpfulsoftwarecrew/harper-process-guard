{
	"name": "@helpfulsoftwarecrew/harper-process-guard",
	"version": "1.0.0",
	"description": "One winner per node for a long-lived child process: a compare-and-swap PID lock, identification by argv, supervision, and a reaper that outlives the host",
	"keywords": [
		"pid",
		"pidfile",
		"lock",
		"supervisor",
		"child-process",
		"worker-threads",
		"harper",
		"harperdb"
	],
	"type": "module",
	"license": "Apache-2.0",
	"author": "HelpfulSoftwareCrew",
	"engines": {
		"node": "^22.18.0 || >=24.0.0"
	},
	"os": [
		"linux",
		"darwin",
		"win32"
	],
	"exports": {
		".": "./src/index.js",
		"./package.json": "./package.json"
	},
	"files": [
		"src/",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/helpfulsoftwarecrew/harper-process-guard.git"
	},
	"homepage": "https://github.com/helpfulsoftwarecrew/harper-process-guard#readme",
	"bugs": {
		"url": "https://github.com/helpfulsoftwarecrew/harper-process-guard/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "oxlint",
		"test": "node --test \"test/**/*.test.js\""
	},
	"devDependencies": {
		"@types/node": "^26.5.1",
		"oxlint": "^1.82.0",
		"prettier": "^3.9.6",
		"typescript": "^7.0.2",
		"yaml": "^2.9.0"
	}
}
